{
  "name": "webgpu-clouds",
  "version": "0.2.0",
  "description": "Standalone flat-world volumetric clouds for Three.js WebGPU (atmosphere-agnostic)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    }
  },
  "files": [
    "dist/package",
    "LICENSE",
    "README.md",
    "USING.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:demo",
    "build:library": "vite build --mode library",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src demo vite.config.ts",
    "format": "biome check --write src demo vite.config.ts",
    "preview": "vite preview --outDir dist/demo"
  },
  "peerDependencies": {
    "three": ">=0.185.0 <0.187.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/three": "^0.186.0",
    "@typescript/typescript6": "^6.0.2",
    "three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.0"
  },
  "keywords": [
    "three",
    "webgpu",
    "clouds",
    "volumetric",
    "tsl"
  ]
}
