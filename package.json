{
  "name": "webgpu-clouds",
  "version": "0.1.0",
  "description": "Standalone flat-world volumetric clouds for Three.js WebGPU",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    }
  },
  "files": [
    "dist/package",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:library && npm run build:demo",
    "build:library": "vite build --mode library",
    "build:demo": "vite build --mode demo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src demo vite.config.ts",
    "format": "prettier --write .",
    "preview": "vite preview --outDir dist/demo"
  },
  "peerDependencies": {
    "three": ">=0.183.0 <0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/three": "0.182.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "three": "0.183.2",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.3.6",
    "vite-plugin-dts": "~4.5.4"
  }
}
